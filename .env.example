# Copy these values from Firebase Console → Project settings → Your apps.
# These are public client settings; never put service account credentials here.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Local Appium/Pytest settings. Copy this file to .env and adjust for your
# machine. Keep values shell-compatible (KEY=value); never commit .env.
# Quote values containing spaces, for example IOS_DEVICE_NAME='iPhone 18'.
EXPO_PUBLIC_APP_ENV=development
# These IDs must identify emulators/simulators. Physical phones are rejected.
ANDROID_UDID=emulator-5554
IOS_UDID=
IOS_DEVICE_NAME=
IOS_PLATFORM_VERSION=
APPIUM_URL=http://127.0.0.1:4723
APPIUM_HOME=./automation/.appium
# scripts/with-env.sh sets PYTHONPATH for automation; keep it out of this file.
OFFLINE_BUNDLED_BUILD=1
OFFLINE_FIREBASE_CONFIGURED=1
OFFLINE_DEMO_PAUSE_SECONDS=0
OFFLINE_RADIO_EVIDENCE_HOLD_SECONDS=0
OFFLINE_SYNC_CONFIRMATION_HOLD_SECONDS=0
APPIUM_RECORD_SCREEN=0

# Multi-device farm sharding (comma-separated: id|version|name)
ANDROID_FARM_DEVICES='emulator-5554|17|sdk_gphone64_arm64,emulator-5556|17|sdk_gphone64_arm64'
IOS_FARM_DEVICES=

# Self-healing UI element locator engine (1 = enabled, 0 = disabled)
ENABLE_SELF_HEALING=1
