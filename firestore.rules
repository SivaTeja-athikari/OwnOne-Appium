rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /environments/{environment}/workspaces/{tenantId}/members/{userId}/submissions/{submissionId} {
      function authorized() {
        return request.auth != null && request.auth.uid == userId
          && tenantId in get(/databases/$(database)/documents/environments/$(environment)/profiles/$(userId)).data.tenantIds;
      }
      allow get: if authorized();
      allow list, update, delete: if false;
      allow create: if authorized()
        && request.resource.data.keys().hasAll(['ownerId','tenantId','title','details','createdAt'])
        && request.resource.data.keys().hasOnly(['ownerId','tenantId','title','details','createdAt','location','category','priority','outcome','riskAssessment','emergencyContact','requiresFollowUp','followUpDate','checklist','signOffName','workOrderReference','nextAction','customFields','formSchemaId','formSchemaVersion'])
        && (!('location' in request.resource.data) || (request.resource.data.location is string && request.resource.data.location.size() <= 160))
        && (!('category' in request.resource.data) || request.resource.data.category in ['Site visit','Delivery','Maintenance','Incident'])
        && (!('priority' in request.resource.data) || request.resource.data.priority in ['Normal','High','Urgent'])
        && (!('outcome' in request.resource.data) || request.resource.data.outcome in ['Completed','In progress','Blocked'])
        && (!('riskAssessment' in request.resource.data) || request.resource.data.riskAssessment in ['Low','Medium','High','Critical'])
        && (!('emergencyContact' in request.resource.data) || (request.resource.data.emergencyContact is string && request.resource.data.emergencyContact.size() <= 24))
        && (!('signOffName' in request.resource.data) || (request.resource.data.signOffName is string && request.resource.data.signOffName.size() <= 120))
        && (!('workOrderReference' in request.resource.data) || (request.resource.data.workOrderReference is string && request.resource.data.workOrderReference.size() <= 80))
        && (!('nextAction' in request.resource.data) || (request.resource.data.nextAction is string && request.resource.data.nextAction.size() <= 1000))
        // Custom field IDs are schema-generated and intentionally not hard-coded
        // here, so clients can add/reorder fields without another rules deploy.
        // Firestore Rules cannot iterate arbitrary map entries to validate each
        // value's type/length; the app enforces those per-field constraints.
        && (!('customFields' in request.resource.data) || (
          request.resource.data.customFields is map
          && request.resource.data.customFields.size() <= 50
          && 'formSchemaId' in request.resource.data
          && 'formSchemaVersion' in request.resource.data
        ))
        && (!('formSchemaId' in request.resource.data) || (request.resource.data.formSchemaId is string && request.resource.data.formSchemaId.size() <= 80))
        && (!('formSchemaVersion' in request.resource.data) || (request.resource.data.formSchemaVersion is int && request.resource.data.formSchemaVersion > 0))
        && (('formSchemaId' in request.resource.data) == ('formSchemaVersion' in request.resource.data))
        && (!('requiresFollowUp' in request.resource.data) || request.resource.data.requiresFollowUp is bool)
        && (!('followUpDate' in request.resource.data) || (request.resource.data.followUpDate is string && request.resource.data.followUpDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && request.resource.data.requiresFollowUp == true))
        && (!('requiresFollowUp' in request.resource.data) || request.resource.data.requiresFollowUp == false || 'followUpDate' in request.resource.data)
        && (!('checklist' in request.resource.data) || (request.resource.data.checklist is list && request.resource.data.checklist.size() <= 10))
        && request.resource.data.ownerId == userId
        && request.resource.data.tenantId == tenantId
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120
        && request.resource.data.details is string
        && request.resource.data.details.size() > 0 && request.resource.data.details.size() <= 2000
        && request.resource.data.createdAt is string && request.resource.data.createdAt.size() <= 40;
    }
    match /environments/{environment}/profiles/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list: if false;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['fullName', 'tenantIds', 'assignedAt', 'activeTenantId'])
        && request.resource.data.fullName is string
        && request.resource.data.tenantIds is list
        && request.resource.data.tenantIds.size() > 0
        && request.resource.data.activeTenantId in request.resource.data.tenantIds;
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activeTenantId'])
        && request.resource.data.activeTenantId in resource.data.tenantIds;
      allow delete: if false;
    }
  }
}
